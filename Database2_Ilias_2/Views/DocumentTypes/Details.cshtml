@model TypeDetailsViewModel
@{
    ViewData["Title"] = Model.Type.Name;
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">
            @Model.Type.Name
            @if (!Model.Type.IsActive)
            {
                <span class="badge bg-secondary">архив</span>
            }
        </h1>
        <div class="text-muted">@Model.Type.Description</div>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Type.Id" class="btn btn-outline-primary">Изменить</a>
        <a asp-action="Index" class="btn btn-link">К списку</a>
    </div>
</div>

<h2 class="h5">Поля</h2>
<table class="table align-middle">
    <thead>
        <tr>
            <th>№</th>
            <th>Подпись</th>
            <th>Служебное имя</th>
            <th>Тип</th>
            <th>Обяз.</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Type.Fields)
        {
            <tr class="@(f.IsActive ? "" : "text-muted")">
                <td>@f.SortOrder</td>
                <td>@f.Label</td>
                <td><code>@f.Name</code></td>
                <td>
                    <div>@f.DataType.Ru()</div>
                    @if (f.DataType == FieldDataType.List)
                    {
                        <div class="small text-muted">@f.Options</div>
                    }
                </td>
                <td>@(f.IsRequired ? "да" : "")</td>
                <td>@(f.IsActive ? "активно" : "отключено")</td>
                <td class="text-end text-nowrap">
                    <a asp-action="EditField" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                    <form asp-action="ToggleField" asp-route-id="@f.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary">@(f.IsActive ? "Отключить" : "Включить")</button>
                    </form>
                    <form asp-action="DeleteField" asp-route-id="@f.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Удалить поле?');">
                        <button class="btn btn-sm btn-outline-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Type.Fields.Any())
        {
            <tr><td colspan="7" class="text-muted">Полей пока нет.</td></tr>
        }
    </tbody>
</table>

<h2 class="h5 mt-4">Добавить поле</h2>
<form asp-action="AddField" method="post" class="col-lg-8">
    <partial name="_FieldForm" model="Model.NewField" />
    <button type="submit" class="btn btn-primary">Добавить поле</button>
</form>

<form asp-action="ToggleActive" asp-route-id="@Model.Type.Id" method="post" class="mt-4">
    <button class="btn btn-outline-secondary">
        @(Model.Type.IsActive ? "Отправить тип в архив" : "Вернуть тип из архива")
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
