@model TypeFormModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Новый тип документа" : "Редактирование типа";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-link">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
