@model List<TypeListItem>
@{
    ViewData["Title"] = "Типы документов";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Типы документов</h1>
    <a asp-action="Create" class="btn btn-primary">Новый тип</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Полей</th>
            <th>Документов</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr class="@(t.IsActive ? "" : "text-muted")">
                <td><a asp-action="Details" asp-route-id="@t.Id">@t.Name</a></td>
                <td>@t.Description</td>
                <td>@t.FieldCount</td>
                <td>@t.DocumentCount</td>
                <td>@(t.IsActive ? "активен" : "в архиве")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-muted">Типов документов пока нет.</td></tr>
        }
    </tbody>
</table>
