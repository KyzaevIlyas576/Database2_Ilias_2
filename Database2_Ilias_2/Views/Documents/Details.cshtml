@model DocumentDetailsViewModel
@{
    var d = Model.Document;
    ViewData["Title"] = d.Title;
}

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@d.Title</h1>
        <div class="text-muted">
            @d.DocumentType.Name · @d.Status.Ru()
        </div>
    </div>
    <div class="text-nowrap">
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-outline-primary">Изменить</a>
        }
        @if (Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Переместить документ в корзину?');">
                <button class="btn btn-outline-danger">Удалить</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-link">К списку</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(d.Summary))
{
    <p>@d.Summary</p>
}

<h2 class="h5 mt-4">Данные документа</h2>
<table class="table col-lg-8">
    <tbody>
        @foreach (var f in Model.Fields)
        {
            <tr>
                <th class="w-25">@f.Label</th>
                <td>@f.Value</td>
            </tr>
        }
        @if (!Model.Fields.Any())
        {
            <tr><td class="text-muted">Поля не заполнены.</td></tr>
        }
    </tbody>
</table>

<div class="small text-muted mt-4">
    Автор: @(d.CreatedBy?.Email ?? "—") ·
    создан @d.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
</div>
